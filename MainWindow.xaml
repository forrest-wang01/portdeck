<Window x:Class="PortDeck.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:PortDeck.Localization"
        xmlns:controls="clr-namespace:PortDeck.Controls"
        Title="PortDeck"
        Width="1260"
        Height="820"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <controls:GroupExpansionConverter x:Key="GroupExpansionConverter" />
    </Window.Resources>

    <Grid x:Name="RootLayout">
    <Border x:Name="WindowFrame" BorderBrush="{StaticResource WindowFrameBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ─────────────────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="20,0,16,0"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#5B9DFF" Offset="0" />
                                        <GradientStop Color="#8B7CFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="P"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource LogoForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Border Width="5"
                                            Height="5"
                                            Background="{StaticResource LogoForegroundBrush}"
                                            CornerRadius="3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,7,7" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PortDeck" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="LOCAL PORTS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="14,16,14,0">
                        <TextBlock Text="{loc:Loc Workspace}" Style="{StaticResource SectionLabelStyle}" Margin="10,0,0,10" />

                        <RadioButton x:Name="NavPorts"
                                     GroupName="Nav"
                                     Style="{StaticResource NavRadioStyle}"
                                     IsChecked="True"
                                     Tag="ports"
                                     Checked="Nav_Checked"
                                     AutomationProperties.Name="{loc:Loc NavAllPorts}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" Style="{StaticResource IconGlyphStyle}" FontSize="15" Width="22" />
                                <TextBlock Text="{loc:Loc NavAllPorts}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavFavorites"
                                     GroupName="Nav"
                                     Style="{StaticResource NavRadioStyle}"
                                     Tag="favorites"
                                     Checked="Nav_Checked"
                                     AutomationProperties.Name="{loc:Loc NavFavorites}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE734;" Style="{StaticResource IconGlyphStyle}" FontSize="15" Width="22" />
                                <TextBlock Text="{loc:Loc NavFavorites}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavHistory"
                                     GroupName="Nav"
                                     Style="{StaticResource NavRadioStyle}"
                                     Tag="history"
                                     Checked="Nav_Checked"
                                     AutomationProperties.Name="{loc:Loc NavHistory}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource IconGlyphStyle}" FontSize="15" Width="22" />
                                <TextBlock Text="{loc:Loc NavHistory}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSettings"
                                     GroupName="Nav"
                                     Style="{StaticResource NavRadioStyle}"
                                     Tag="settings"
                                     Checked="Nav_Checked"
                                     AutomationProperties.Name="{loc:Loc NavSettings}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyphStyle}" FontSize="15" Width="22" />
                                <TextBlock Text="{loc:Loc NavSettings}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="10,16,10,16" />

                        <TextBlock Text="{loc:Loc ScanStatus}" Style="{StaticResource SectionLabelStyle}" Margin="10,0,0,10" />

                        <Border Background="{StaticResource SurfaceSunkenBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot"
                                             Width="7"
                                             Height="7"
                                             Fill="{StaticResource AccentBrush}"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusText"
                                               Text="{loc:Loc ReadyToScan}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="LastScanText"
                                           Text="{loc:Loc AwaitingFirstScan}"
                                           Style="{StaticResource MutedTextStyle}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Margin="15,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource LocalOnlySurfaceBrush}"
                                BorderBrush="{StaticResource LocalOnlyBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;"
                                           Style="{StaticResource IconGlyphStyle}"
                                           FontSize="14"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Loc LocalOnly}"
                                           FontSize="11"
                                           Foreground="{StaticResource LocalOnlyTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="20,0,20,18">
                        <TextBlock x:Name="VersionText"
                                   Text="v1.1.0"
                                   Foreground="{StaticResource FaintBrush}"
                                   FontSize="10.5" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Main ────────────────────────────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                        <TextBlock Text="PORTDECK"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource FaintBrush}" />
                        <TextBlock Text="/" FontSize="10" Foreground="{StaticResource FaintBrush}" Margin="7,0" />
                        <TextBlock Text="LOCAL SERVICE MONITOR"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource FaintBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WindowControlButtonStyle}" Click="Minimize_Click" ToolTip="{loc:Loc TooltipMinimize}">
                            <TextBlock Text="&#xE921;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButtonStyle}" Click="Maximize_Click" ToolTip="{loc:Loc TooltipMaximize}">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource WindowControlButtonStyle}" Click="Close_Click" ToolTip="{loc:Loc Close}">
                            <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="28,4,28,24">
                    <!-- ── Dashboard ─────────────────────────────────────── -->
                    <Grid x:Name="DashboardView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,4,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="PageTitle" Text="{loc:Loc LocalServicesTitle}" Style="{StaticResource PageTitleStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <TextBlock x:Name="PageSubtitle"
                                               Text="{loc:Loc LocalServicesSubtitle}"
                                               Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Text="  ·  " Foreground="{StaticResource FaintBrush}" FontSize="12" />
                                    <TextBlock x:Name="ScanInfoText"
                                               Text="{loc:Loc Preparing}"
                                               Foreground="{StaticResource FaintBrush}"
                                               FontSize="12" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="306"
                                        Height="38"
                                        Background="{StaticResource PanelRaisedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE721;"
                                                   Style="{StaticResource IconGlyphStyle}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource FaintBrush}" />
                                        <TextBox x:Name="SearchBox"
                                                 Grid.Column="1"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 TextChanged="SearchBox_TextChanged"
                                                 Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{loc:Loc SearchPlaceholder}"
                                                   Foreground="{StaticResource FaintBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Button x:Name="RefreshButton"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="11,0"
                                        Height="38"
                                        Margin="0,0,8,0"
                                        Click="Refresh_Click"
                                        ToolTip="{loc:Loc TooltipRefresh}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyphStyle}" FontSize="13" />
                                        <TextBlock Text="{loc:Loc RefreshShort}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Border Height="38"
                                        Background="{StaticResource PanelRaisedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc AutoRefresh}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <CheckBox x:Name="AutoRefreshToggle"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Margin="10,0,0,0"
                                                  IsChecked="True"
                                                  Checked="AutoRefresh_Changed"
                                                  Unchecked="AutoRefresh_Changed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Stats -->
                        <Grid Grid.Row="1" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc ListeningPorts}" Style="{StaticResource MutedTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock x:Name="StatPorts" Text="—" FontFamily="Cascadia Mono, Consolas" FontSize="24" FontWeight="SemiBold" />
                                            <TextBlock Text="{loc:Loc TransportSummary}" FontSize="10" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE71D;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc ActiveProcesses}" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock x:Name="StatProcesses" Text="—" FontFamily="Cascadia Mono, Consolas" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{StaticResource StatVioletBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE950;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Foreground="{StaticResource BlueBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc FavoritesStat}" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock x:Name="StatFavorites" Text="—" FontFamily="Cascadia Mono, Consolas" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{StaticResource StatAmberBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE735;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Foreground="{StaticResource WarnBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc PortConflicts}" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock x:Name="StatConflictsText"
                                                   Text="—"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Margin="0,6,0,0"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{StaticResource StatRedBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconGlyphStyle}" FontSize="14" Foreground="{StaticResource DangerBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Filters -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ChipAll"
                                             GroupName="Filter"
                                             Style="{StaticResource ChipRadioStyle}"
                                             Content="{loc:Loc FilterAll}"
                                             Tag="all"
                                             IsChecked="True"
                                             Checked="Filter_Checked" />
                                <RadioButton x:Name="ChipDev"
                                             GroupName="Filter"
                                             Style="{StaticResource ChipRadioStyle}"
                                             Content="{loc:Loc FilterDev}"
                                             Tag="dev"
                                             Checked="Filter_Checked" />
                                <RadioButton x:Name="ChipFavorite"
                                             GroupName="Filter"
                                             Style="{StaticResource ChipRadioStyle}"
                                             Content="{loc:Loc FilterFavorite}"
                                             Tag="favorite"
                                             Checked="Filter_Checked" />
                                <RadioButton x:Name="ChipConflict"
                                             GroupName="Filter"
                                             Style="{StaticResource ChipRadioStyle}"
                                             Content="{loc:Loc PortConflicts}"
                                             Tag="conflict"
                                             Checked="Filter_Checked" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="ResultCountText"
                                           Text="—"
                                           Style="{StaticResource MutedTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <Button x:Name="HideSystemButton"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="9,6"
                                        Margin="0,0,8,0"
                                        Click="ToggleSystem_Click"
                                        ToolTip="{loc:Loc ShowSystemProcesses}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7B3;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
                                        <TextBlock x:Name="HideSystemLabel" Text="{loc:Loc HideSystem}" Margin="6,0,0,0" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="GroupButton"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,6"
                                        Margin="0,0,8,0"
                                        Click="Group_Click"
                                        ToolTip="{loc:Loc TooltipGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8F1;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
                                        <TextBlock x:Name="GroupLabel" Text="{loc:Loc GroupByProject}" Margin="6,0,0,0" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,6"
                                        Margin="0,0,8,0"
                                        Click="Sort_Click"
                                        ToolTip="{loc:Loc TooltipSort}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8CB;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
                                        <TextBlock x:Name="SortLabel" Text="{loc:Loc SortPortAsc}" Margin="6,0,0,0" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,6"
                                        Click="Export_Click"
                                        ToolTip="{loc:Loc TooltipExport}"
                                        AutomationProperties.Name="{loc:Loc Export}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
                                        <TextBlock Text="{loc:Loc Export}" Margin="6,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Port list -->
                        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{StaticResource SurfaceSunkenBrush}"
                                        BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="12,12,0,0"
                                        Padding="14,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding StarColumnWidth, ElementName=RootWindow}" />
                                            <ColumnDefinition Width="{Binding PortColumnWidth, ElementName=RootWindow}" />
                                            <ColumnDefinition Width="{Binding ProcessColumnWidth, ElementName=RootWindow}" />
                                            <ColumnDefinition Width="{Binding ProjectColumnWidth, ElementName=RootWindow}" />
                                            <ColumnDefinition Width="{Binding AddressColumnWidth, ElementName=RootWindow}" />
                                            <ColumnDefinition Width="{Binding PidColumnWidth, ElementName=RootWindow}" />
                                            <ColumnDefinition Width="{Binding ActionsColumnWidth, ElementName=RootWindow}" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="HeaderPort" Grid.Column="1" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{loc:Loc ColumnPort}" Click="HeaderPort_Click" />
                                        <Button x:Name="HeaderProcess" Grid.Column="2" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{loc:Loc ColumnProcess}" Click="HeaderProcess_Click" />
                                        <Button x:Name="HeaderProject" Grid.Column="3" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{loc:Loc ColumnProject}" Click="HeaderProject_Click" />
                                        <Button x:Name="HeaderAddress" Grid.Column="4" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{loc:Loc ColumnAddress}" Click="HeaderAddress_Click" />
                                        <Button x:Name="HeaderPid" Grid.Column="5" Style="{StaticResource ColumnHeaderButtonStyle}" Content="PID" Click="HeaderPid_Click" />
                                        <TextBlock Grid.Column="6" Text="{loc:Loc ColumnActions}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                        <Thumb Grid.Column="1" Width="6" HorizontalAlignment="Right" Style="{StaticResource ColumnResizeThumbStyle}" Tag="1" DragDelta="ColumnResize_DragDelta" DragCompleted="ColumnResize_DragCompleted" Panel.ZIndex="2" />
                                        <Thumb Grid.Column="2" Width="6" HorizontalAlignment="Right" Style="{StaticResource ColumnResizeThumbStyle}" Tag="2" DragDelta="ColumnResize_DragDelta" DragCompleted="ColumnResize_DragCompleted" Panel.ZIndex="2" />
                                        <Thumb Grid.Column="3" Width="6" HorizontalAlignment="Right" Style="{StaticResource ColumnResizeThumbStyle}" Tag="3" DragDelta="ColumnResize_DragDelta" DragCompleted="ColumnResize_DragCompleted" Panel.ZIndex="2" />
                                        <Thumb Grid.Column="4" Width="6" HorizontalAlignment="Right" Style="{StaticResource ColumnResizeThumbStyle}" Tag="4" DragDelta="ColumnResize_DragDelta" DragCompleted="ColumnResize_DragCompleted" Panel.ZIndex="2" />
                                        <Thumb Grid.Column="5" Width="6" HorizontalAlignment="Right" Style="{StaticResource ColumnResizeThumbStyle}" Tag="5" DragDelta="ColumnResize_DragDelta" DragCompleted="ColumnResize_DragCompleted" Panel.ZIndex="2" />
                                        <Thumb Grid.Column="6" Width="6" HorizontalAlignment="Right" Style="{StaticResource ColumnResizeThumbStyle}" Tag="6" DragDelta="ColumnResize_DragDelta" DragCompleted="ColumnResize_DragCompleted" Panel.ZIndex="2" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1">
                                    <ListBox x:Name="PortsList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             ItemContainerStyle="{StaticResource PortListItemStyle}"
                                             PreviewKeyDown="PortsList_PreviewKeyDown">
                                        <ListBox.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />
                                        </ListBox.Resources>
                                        <ListBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="{x:Type GroupItem}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                    <Expander IsExpanded="{Binding Name, Mode=OneWay, Converter={StaticResource GroupExpansionConverter}}"
                                                                              Expanded="Group_Expanded"
                                                                              Collapsed="Group_Collapsed"
                                                                              Style="{StaticResource PortGroupExpanderStyle}">
                                                                        <Expander.Header>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE8B7;"
                                                                                           Style="{StaticResource IconGlyphStyle}"
                                                                                           FontSize="12"
                                                                                           Foreground="{StaticResource AccentBrush}"
                                                                                           Margin="0,0,8,0" />
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           FontSize="12"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{StaticResource TextBrush}" />
                                                                                <Border Background="{StaticResource ChipSurfaceBrush}"
                                                                                        CornerRadius="4"
                                                                                        Padding="6,1"
                                                                                        Margin="8,0,0,0"
                                                                                        VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding ItemCount, Converter={StaticResource PortCountConverter}}"
                                                                                               FontSize="9.5"
                                                                                               Foreground="{StaticResource MutedBrush}" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Expander.Header>
                                                                        <ItemsPresenter />
                                                                    </Expander>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                    <Border Style="{StaticResource PortRowStyle}"
                                                            Tag="{Binding}"
                                                            MouseLeftButtonUp="PortRow_MouseLeftButtonUp">
                                                        <Border.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="{loc:Loc TooltipHealth}" Click="ContextHealth_Click" />
                                                                <MenuItem Header="{loc:Loc TooltipDetails}" Click="ContextDetails_Click" />
                                                                <MenuItem Header="{loc:Loc TooltipOpen}" Click="ContextOpen_Click" />
                                                                <MenuItem Header="{loc:Loc TooltipCopy}" Click="ContextCopy_Click" />
                                                                <Separator />
                                                                <MenuItem Header="{loc:Loc KillProcess}" Click="ContextKill_Click" />
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding StarColumnWidth, ElementName=RootWindow}" />
                                                                <ColumnDefinition Width="{Binding PortColumnWidth, ElementName=RootWindow}" />
                                                                <ColumnDefinition Width="{Binding ProcessColumnWidth, ElementName=RootWindow}" />
                                                                <ColumnDefinition Width="{Binding ProjectColumnWidth, ElementName=RootWindow}" />
                                                                <ColumnDefinition Width="{Binding AddressColumnWidth, ElementName=RootWindow}" />
                                                                <ColumnDefinition Width="{Binding PidColumnWidth, ElementName=RootWindow}" />
                                                                <ColumnDefinition Width="{Binding ActionsColumnWidth, ElementName=RootWindow}" />
                                                            </Grid.ColumnDefinitions>

                                                            <Button Grid.Column="0"
                                                                    Style="{StaticResource StarButtonStyle}"
                                                                    Content="{Binding FavoriteGlyph}"
                                                                    Tag="{Binding}"
                                                                    Click="Favorite_Click"
                                                                    ToolTip="{loc:Loc TooltipFavorite}"
                                                                    AutomationProperties.Name="{Binding FavoriteAutomationName}"
                                                                    HorizontalAlignment="Left"
                                                                    FontFamily="Segoe MDL2 Assets"
                                                                    FontSize="14" />

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Port}"
                                                                               FontFamily="Cascadia Mono, Consolas"
                                                                               FontSize="19"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextBrush}" />
                                                                    <Border Background="{StaticResource DangerSoftBrush}"
                                                                            CornerRadius="4"
                                                                            Padding="4,1"
                                                                            Margin="5,2,0,0"
                                                                            VerticalAlignment="Top"
                                                                            Visibility="{Binding Conflict, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{loc:Loc Conflict}" FontSize="9.5" Foreground="{StaticResource DangerTextBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="1,2,0,0">
                                                                    <TextBlock Text="{Binding ProtocolLabel}"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource FaintBrush}" />
                                                                    <TextBlock Text="{Binding HealthLabel}"
                                                                               FontSize="10"
                                                                               Margin="6,0,0,0"
                                                                               Visibility="{Binding HasHealthResult, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HealthTone}" Value="healthy">
                                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding HealthTone}" Value="unhealthy">
                                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="36" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="30"
                                                                        Height="30"
                                                                        CornerRadius="8"
                                                                        Background="{StaticResource ProcessIconTileBrush}"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Left">
                                                                    <Grid>
                                                                        <Image Source="{Binding ProcessIcon}"
                                                                               Width="20"
                                                                               Height="20"
                                                                               Stretch="Uniform"
                                                                               RenderOptions.BitmapScalingMode="HighQuality">
                                                                            <Image.Style>
                                                                                <Style TargetType="Image">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ProcessIcon}" Value="{x:Null}">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Image.Style>
                                                                        </Image>
                                                                        <TextBlock Text="&#xE71D;"
                                                                                   FontSize="14"
                                                                                   Foreground="{StaticResource MutedBrush}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconGlyphStyle}">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ProcessIcon}" Value="{x:Null}">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                                                                    <controls:HighlightTextBlock SourceText="{Binding ProcessName}"
                                                                                                 Query="{Binding SearchQuery, ElementName=RootWindow}"
                                                                                                 FontSize="12.5"
                                                                                                 FontWeight="SemiBold"
                                                                                                 TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding CommandPreview}"
                                                                               FontSize="10.5"
                                                                               Foreground="{StaticResource FaintBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <controls:HighlightTextBlock SourceText="{Binding ProjectName}"
                                                                                             Query="{Binding SearchQuery, ElementName=RootWindow}"
                                                                                             FontSize="12"
                                                                                             TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding ProjectType}"
                                                                           FontSize="10.5"
                                                                           Foreground="{StaticResource FaintBrush}"
                                                                           Margin="0,3,0,0"
                                                                           Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                                <controls:HighlightTextBlock SourceText="{Binding AddressSummary}"
                                                                                             Query="{Binding SearchQuery, ElementName=RootWindow}"
                                                                                             FontFamily="Cascadia Mono, Consolas"
                                                                                             FontSize="10.5"
                                                                                             Foreground="{StaticResource MutedBrush}"
                                                                                             TextTrimming="CharacterEllipsis" />
                                                                <Border Background="{StaticResource ChipSurfaceBrush}"
                                                                        CornerRadius="4"
                                                                        Padding="5,1"
                                                                        Margin="0,4,0,0"
                                                                        HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding ExposureLabel}" FontSize="9.5">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Exposure}" Value="all">
                                                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Exposure}" Value="lan">
                                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Exposure}" Value="public">
                                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="5"
                                                                       Text="{Binding PidLabel}"
                                                                       FontFamily="Cascadia Mono, Consolas"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource FaintBrush}"
                                                                       VerticalAlignment="Center" />

                                                            <StackPanel Grid.Column="6"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center">
                                                                <Button Style="{StaticResource SmallIconButtonStyle}"
                                                                        Tag="{Binding}"
                                                                        Click="ShowDetail_Click"
                                                                        ToolTip="{loc:Loc TooltipDetails}"
                                                                        AutomationProperties.Name="{Binding DetailAutomationName}">
                                                                    <TextBlock Text="&#xE946;" Style="{StaticResource IconGlyphStyle}" FontSize="11" />
                                                                </Button>
                                                                <Button Style="{StaticResource RowMoreButtonStyle}"
                                                                        Tag="{Binding}"
                                                                        Click="RowMore_Click"
                                                                        ToolTip="{loc:Loc MoreActions}"
                                                                        AutomationProperties.Name="{loc:Loc MoreActions}">
                                                                    <TextBlock Text="&#xE712;" Style="{StaticResource IconGlyphStyle}" FontSize="14" />
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                            <MenuItem Header="{loc:Loc TooltipHealth}" Click="ContextHealth_Click" />
                                                                            <MenuItem Header="{loc:Loc TooltipOpen}" Click="ContextOpen_Click" />
                                                                            <MenuItem Header="{loc:Loc TooltipCopy}" Click="ContextCopy_Click" />
                                                                            <Separator />
                                                                            <MenuItem Header="{loc:Loc KillProcess}" Click="ContextKill_Click" />
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <ProgressBar x:Name="LoadingBar"
                                                 IsIndeterminate="True"
                                                 Height="2"
                                                 VerticalAlignment="Top"
                                                 Background="Transparent"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 BorderThickness="0"
                                                 Visibility="Collapsed" />

                                    <Grid x:Name="EmptyState" Background="{StaticResource PanelBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="56" Height="56" CornerRadius="15" Background="{StaticResource EmptyIconBrush}" BorderBrush="{StaticResource EmptyIconBorderBrush}" BorderThickness="1">
                                                <TextBlock Text="&#xE71D;" Style="{StaticResource IconGlyphStyle}" FontSize="22" Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <TextBlock x:Name="EmptyTitle"
                                                       Text="{loc:Loc ScanningPorts}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,14,0,0" />
                                            <TextBlock x:Name="EmptySubtitle"
                                                       Text="{loc:Loc FirstScanHint}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,6,0,0" />
                                            <Button x:Name="EmptyAction"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Content="{loc:Loc ClearFilters}"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,16,0,0"
                                                    Visibility="Collapsed"
                                                    Click="ClearFilter_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ── Settings ──────────────────────────────────────── -->
                    <ScrollViewer x:Name="SettingsView"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />
                        </ScrollViewer.Resources>
                        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
                            <TextBlock Text="PREFERENCES" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock Text="{loc:Loc NavSettings}" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="{loc:Loc SettingsSubtitle}"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,7,0,0" />

                            <Expander Header="{loc:Loc SettingsGroupScan}" IsExpanded="True" Style="{StaticResource SettingsExpanderStyle}">
                            <StackPanel Margin="0,10,0,0">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc RefreshInterval}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc RefreshIntervalHint}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="Interval3" GroupName="Interval" Style="{StaticResource ChipRadioStyle}" Content="{loc:Loc Seconds3}" Tag="3" Checked="Interval_Checked" AutomationProperties.Name="{loc:Loc Seconds3}" />
                                        <RadioButton x:Name="Interval5" GroupName="Interval" Style="{StaticResource ChipRadioStyle}" Content="{loc:Loc Seconds5}" Tag="5" IsChecked="True" Checked="Interval_Checked" AutomationProperties.Name="{loc:Loc Seconds5}" />
                                        <RadioButton x:Name="Interval10" GroupName="Interval" Style="{StaticResource ChipRadioStyle}" Content="{loc:Loc Seconds10}" Tag="10" Checked="Interval_Checked" AutomationProperties.Name="{loc:Loc Seconds10}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc ShowSystemProcesses}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc ShowSystemHint}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"
                                                   MaxWidth="540"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <CheckBox x:Name="ShowSystemToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="False"
                                              VerticalAlignment="Center"
                                              Checked="ShowSystem_Changed"
                                              Unchecked="ShowSystem_Changed" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc CloseToTray}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc CloseToTrayHint}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"
                                                   MaxWidth="540"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <CheckBox x:Name="CloseToTrayToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Checked="CloseToTray_Changed"
                                              Unchecked="CloseToTray_Changed" />
                                </Grid>
                            </Border>
                            </StackPanel>
                            </Expander>

                            <Expander Header="{loc:Loc SettingsGroupData}" IsExpanded="True" Style="{StaticResource SettingsExpanderStyle}">
                            <StackPanel Margin="0,10,0,0">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc FavoriteData}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc FavoriteDataHint}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,5,0,0" />
                                    <Border Background="{StaticResource SurfaceSunkenBrush}"
                                            BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,12,0,12">
                                        <TextBlock x:Name="DataPathText"
                                                   Text="%APPDATA%\PortDeck\favorites.json"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource FaintBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource DangerButtonStyle}"
                                                Content="{loc:Loc ClearFavorites}"
                                                HorizontalAlignment="Left"
                                                Click="ClearFavorites_Click" />
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Content="{loc:Loc OpenLogs}"
                                                Margin="8,0,0,0"
                                                HorizontalAlignment="Left"
                                                Click="OpenLogs_Click" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc OpenLogsHint}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                            </StackPanel>
                            </Expander>

                            <Expander Header="{loc:Loc SettingsGroupAppearance}" IsExpanded="True" Style="{StaticResource SettingsExpanderStyle}">
                            <StackPanel Margin="0,10,0,0">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Appearance}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc ThemeHint}"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <RadioButton x:Name="ThemeDark"
                                                     GroupName="Theme"
                                                     Style="{StaticResource ChipRadioStyle}"
                                                     Content="{loc:Loc ThemeDark}"
                                                     Tag="dark"
                                                     IsChecked="True"
                                                     Checked="Theme_Checked" />
                                        <RadioButton x:Name="ThemeLight"
                                                     GroupName="Theme"
                                                     Style="{StaticResource ChipRadioStyle}"
                                                     Content="{loc:Loc ThemeLight}"
                                                     Tag="light"
                                                     Checked="Theme_Checked" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc UiScale}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,16,0,4" />
                                    <TextBlock Text="{loc:Loc UiScaleHint}"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Scale100"
                                                     GroupName="Scale"
                                                     Style="{StaticResource ChipRadioStyle}"
                                                     Content="{loc:Loc Scale100}"
                                                     Tag="100"
                                                     IsChecked="True"
                                                     Checked="Scale_Checked" />
                                        <RadioButton x:Name="Scale125"
                                                     GroupName="Scale"
                                                     Style="{StaticResource ChipRadioStyle}"
                                                     Content="{loc:Loc Scale125}"
                                                     Tag="125"
                                                     Checked="Scale_Checked" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Language}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc LanguageHint}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,5,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <RadioButton x:Name="LanguageSystem"
                                                     GroupName="Language"
                                                     Style="{StaticResource ChipRadioStyle}"
                                                     Content="{loc:Loc LanguageSystem}"
                                                     Tag="system"
                                                     IsChecked="True"
                                                     Checked="Language_Checked" />
                                        <RadioButton x:Name="LanguageChinese"
                                                     GroupName="Language"
                                                     Style="{StaticResource ChipRadioStyle}"
                                                     Content="{loc:Loc LanguageChinese}"
                                                     Tag="zh-CN"
                                                     Checked="Language_Checked" />
                                        <RadioButton x:Name="LanguageEnglish"
                                                     GroupName="Language"
                                                     Style="{StaticResource ChipRadioStyle}"
                                                     Content="{loc:Loc LanguageEnglish}"
                                                     Tag="en-US"
                                                     Checked="Language_Checked" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                            </Expander>

                            <Expander Header="{loc:Loc SettingsGroupUpdates}" IsExpanded="True" Style="{StaticResource SettingsExpanderStyle}">
                            <StackPanel Margin="0,10,0,0">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc AutoUpdate}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc AutoUpdateHint}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"
                                                   MaxWidth="540"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <CheckBox x:Name="AutoUpdateToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Checked="AutoUpdate_Changed"
                                              Unchecked="AutoUpdate_Changed" />
                                </Grid>
                            </Border>
                            </StackPanel>
                            </Expander>

                            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc About}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AboutVersionText"
                                               Text="v1.1.0"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{loc:Loc AboutTech}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{loc:Loc AboutPrivacy}"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="CheckUpdateButton"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Content="{loc:Loc CheckForUpdates}"
                                                Click="CheckUpdates_Click" />
                                        <TextBlock x:Name="UpdateStatusText"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Activity history ─────────────────────────────── -->
                    <Grid x:Name="HistoryView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,4,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ACTIVITY LOG" Style="{StaticResource EyebrowStyle}" />
                                <TextBlock Text="{loc:Loc HistoryTitle}" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="{loc:Loc HistorySubtitle}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,7,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Content="{loc:Loc ClearHistory}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="ClearHistory_Click" />
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <ListBox x:Name="HistoryList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ItemContainerStyle="{StaticResource PortListItemStyle}">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PortRowStyle}" Height="68">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="150" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TimeLabel}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="1"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EventTone}" Value="down">
                                                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding EventLabel}" FontSize="10">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EventTone}" Value="down">
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{StaticResource FaintBrush}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Address}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid x:Name="HistoryEmptyState" Background="{StaticResource PanelBrush}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="56" Height="56" CornerRadius="15" Background="{StaticResource EmptyIconBrush}" BorderBrush="{StaticResource EmptyIconBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="&#xE81C;" Style="{StaticResource IconGlyphStyle}" FontSize="22" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                        <TextBlock Text="{loc:Loc HistoryEmpty}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                        <TextBlock Text="{loc:Loc HistoryEmptyHint}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>

    <!-- ── Detail drawer ─────────────────────────────────────────────── -->
    <Grid x:Name="DetailOverlay"
          Background="{StaticResource OverlayBrush}"
          Visibility="Collapsed"
          Panel.ZIndex="20"
          MouseLeftButtonUp="DetailOverlay_MouseLeftButtonUp">
        <Border x:Name="DetailPanel"
                Width="440"
                Background="{StaticResource SurfaceSunkenBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,12,12,12"
                Padding="22"
                MouseLeftButtonUp="DetailPanel_MouseLeftButtonUp">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Thumb x:Name="DetailResizeThumb"
                       Width="8"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Stretch"
                       Margin="0"
                       Cursor="SizeWE"
                       Style="{StaticResource DetailResizeThumbStyle}"
                       DragDelta="DetailResize_DragDelta"
                       DragCompleted="DetailResize_DragCompleted"
                       Panel.ZIndex="5" />

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="PORT DETAILS" Style="{StaticResource EyebrowStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding Port}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="34"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ProtocolLabel}"
                                       FontSize="10"
                                       Foreground="{StaticResource FaintBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="7,0,0,9" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Image Source="{Binding ProcessIcon}"
                                   Width="18"
                                   Height="18"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProcessIcon}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="{Binding ProcessName}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PidLabel}"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="DetailCopyJson_Click"
                                ToolTip="{loc:Loc TooltipCopyJson}"
                                AutomationProperties.Name="{loc:Loc TooltipCopyJson}">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="DetailTerminal_Click"
                                ToolTip="{loc:Loc TooltipTerminal}"
                                AutomationProperties.Name="{loc:Loc TooltipTerminal}">
                            <TextBlock Text="&#xE756;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="CloseDetail_Click"
                                ToolTip="{loc:Loc Close}"
                                AutomationProperties.Name="{loc:Loc Close}">
                            <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,18,0,14">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Padding="9,6"
                                    Tag="{Binding}"
                                    Click="DetailFavorite_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FavoriteGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Favorite}" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Padding="9,6"
                                    Margin="8,0,0,0"
                                    Tag="{Binding}"
                                    Click="DetailHealth_Click"
                                    ToolTip="{loc:Loc TooltipHealth}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyphStyle}" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding HealthLabel}" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Border Background="{StaticResource ChipSurfaceBrush}" CornerRadius="6" Padding="8,5" Margin="8,0,0,0">
                                <TextBlock Text="{Binding ExposureLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                            </Border>
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8,5" Margin="6,0,0,0"
                                    Visibility="{Binding IsDev, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc FilterDev}" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}" Background="{StaticResource SurfaceSunkenBrush}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{loc:Loc ColumnProcess}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProcessFile}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="1" Text="{loc:Loc ListeningAddress}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AddressDetail}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="2" Text="{loc:Loc StartedAt}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StartedAtLabel}" FontSize="11" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="3" Text="{loc:Loc ColumnProject}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding ProjectSummary}" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ProjectPathLabel}" FontSize="9.5" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding ContainerSummary}"
                                               FontSize="9.5"
                                               Foreground="{StaticResource BlueBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"
                                               Visibility="{Binding HasContainer, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding WslSummary}"
                                               FontSize="9.5"
                                               Foreground="{StaticResource AccentBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"
                                               Visibility="{Binding HasWsl, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <TextBlock Grid.Row="4" Text="{loc:Loc WorkingDirectory}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WorkingDirectoryLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="5" Text="{loc:Loc Executable}" Style="{StaticResource SectionLabelStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ExePath}" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:Loc CommandLine}" Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,8" />
                        <Border Background="{StaticResource CodeSurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="11">
                            <TextBlock Text="{Binding CommandDisplay}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{loc:Loc OpenService}"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding IsTcp}"
                            Tag="{Binding}"
                            Click="DetailOpen_Click" />
                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="{loc:Loc CopyAddress}"
                            Margin="8,0,0,0"
                            Tag="{Binding}"
                            Click="DetailCopy_Click" />
                    <Button Grid.Column="2"
                            Style="{StaticResource DangerButtonStyle}"
                            Content="{loc:Loc KillProcess}"
                            Margin="8,0,0,0"
                            Tag="{Binding}"
                            Click="DetailKill_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <!-- ── Kill confirmation ─────────────────────────────────────────── -->
    <Grid x:Name="KillOverlay"
          Background="{StaticResource OverlayStrongBrush}"
          Visibility="Collapsed"
          Panel.ZIndex="30">
        <Border Width="440"
                Background="{StaticResource ModalSurfaceBrush}"
                BorderBrush="{StaticResource ModalBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource DangerSoftBrush}" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource IconGlyphStyle}" FontSize="18" Foreground="{StaticResource DangerBrush}" />
                </Border>
                <TextBlock Text="{loc:Loc KillTitle}" FontSize="19" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock x:Name="KillMessage"
                           Text=""
                           Style="{StaticResource MutedTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
                <TextBlock Text="{loc:Loc KillWarning}"
                           Foreground="{StaticResource WarnBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="{loc:Loc Cancel}"
                            HorizontalAlignment="Stretch"
                            Click="CancelKill_Click" />
                    <Button x:Name="ConfirmKillButton"
                            Grid.Column="1"
                            Style="{StaticResource DangerButtonStyle}"
                            Content="{loc:Loc KillProcess}"
                            Margin="8,0,0,0"
                            Click="ConfirmKill_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <!-- ── Toast ─────────────────────────────────────────────────────── -->
    <Border x:Name="Toast"
            Panel.ZIndex="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,28"
            Background="{StaticResource ToastSurfaceBrush}"
            BorderBrush="{StaticResource ToastBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,10"
            Opacity="0"
            Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ToastGlyph"
                       Text="&#xE73E;"
                       Style="{StaticResource IconGlyphStyle}"
                       FontSize="13"
                       Foreground="{StaticResource AccentBrush}"
                       Margin="0,0,8,0" />
            <TextBlock x:Name="ToastText" Text="" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
    </Grid>
</Window>
