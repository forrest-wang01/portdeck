<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgColor">#F3F6FA</Color>
    <Color x:Key="SidebarColor">#FFFFFF</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <Color x:Key="PanelRaisedColor">#EDF2F7</Color>
    <Color x:Key="BorderColor">#D6DFE9</Color>
    <Color x:Key="DividerColor">#E5EBF2</Color>
    <Color x:Key="TextColor">#17202B</Color>
    <Color x:Key="MutedColor">#5C6B7C</Color>
    <Color x:Key="FaintColor">#6F7E8E</Color>
