<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="PortDeck-*-win-x64.exe"
             product-name="PortDeck"
             product-version="${version}">
      <authenticode-sign/>
    </pe-file>
    <pe-file path="PortDeck-*-win-arm64.exe"
             product-name="PortDeck"
             product-version="${version}">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
